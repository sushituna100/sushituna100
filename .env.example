# SolidPilot's AI copilot runs entirely on a local, open-source LLM via Ollama
# (https://ollama.com) — no cloud API key, no cost. Install Ollama, then:
#   ollama pull qwen2.5-coder:7b
#   ollama serve
# and the copilot will pick it up automatically with the defaults below.

# Base URL of your running Ollama instance (default is correct for a local install)
# OLLAMA_HOST=http://localhost:11434

# Any Ollama model with tool/function-calling support works. qwen2.5-coder:7b is a
# good default (~4.7GB, runs on CPU or a modest GPU). For better reliability on
# multi-step edits, if you have the VRAM/RAM: qwen2.5-coder:14b or qwen2.5:32b.
# OLLAMA_MODEL=qwen2.5-coder:7b

# Optional overrides
# PORT=8787
# PROJECTS_DIR=./projects
